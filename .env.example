# OpenAI API Key (optional but recommended for better AI clip detection)
# Get your key from: https://platform.openai.com/
# 
# Usage Tips:
# - GPT-4: Best quality, higher cost (~$0.03-0.06 per request)
# - GPT-3.5-turbo: Good quality, lower cost (~$0.0015-0.002 per request)
# - Change model in config.json: "ai_settings" -> "model"
#
OPENAI_API_KEY=your_api_key_here

# Optional local model. If LLM_BASE_URL is set, it is used instead of OpenAI.
# Leave it blank to auto-detect Ollama at http://127.0.0.1:11434 when no OpenAI key is set.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

